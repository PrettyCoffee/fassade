{
  "name": "goobrrr",
  "version": "0.1.0",
  "description": "A less than 1KB css-in-js solution",
  "keywords": [
    "css-in-js",
    "goober",
    "styled",
    "javascript",
    "react",
    "preact"
  ],
  "author": "Cristian <botecristian@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cristianbote/goober"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./jsx": {
      "import": "./dist/jsx/index.js",
      "types": "./dist/jsx/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm run dev:lib & cd demos/vite && pnpm run dev",
    "dev:waku": "pnpm run dev:lib & cd demos/waku && pnpm run dev",
    "dev:lib": "pnpm run build --watch",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "vitest watch",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19"
  },
  "devDependencies": {
    "@pretty-cozy/oxlint-config": "0.2.2",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "5.0.0",
    "happy-dom": "20.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{html,md,json,yaml}": [
      "oxfmt --write"
    ]
  }
}
